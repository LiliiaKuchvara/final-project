    <worksheet name='Late Share Heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='10'>Late Deliveries Are Most Frequent at Specific Hours</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='9'>Late Deliveries Vary by Hour and Day of Week</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_clean+' name='federated.18qdsgh1vinxzp15u2zn219tbs1p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Допустиме запізнення, хв' datatype='integer' name='[Parameter 1319140902215696]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='1' max='15' min='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18qdsgh1vinxzp15u2zn219tbs1p'>
            <column caption='Is Late' datatype='integer' name='[Calculation_1319140885954564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [delivery_time_min] &gt;&#13;&#10;   [promised_time_min] + [Parameters].[Parameter 1319140902215696]&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
