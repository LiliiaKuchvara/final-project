            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.18qdsgh1vinxzp15u2zn219tbs1p].[avg:Calculation_1051410128879618:qk]&quot;' />
