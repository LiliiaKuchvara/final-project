            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='9'>Customer Ratings Drop to 2.56 for Delays Over 20 Minutes</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_clean+' name='federated.18qdsgh1vinxzp15u2zn219tbs1p' />
