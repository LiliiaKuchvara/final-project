          </datasources>
          <datasource-dependencies datasource='federated.18qdsgh1vinxzp15u2zn219tbs1p'>
            <column caption='GMV' datatype='integer' name='[Calculation_1319140884926464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &quot;delivered&quot; THEN [total_uah]&#13;&#10;END' />
            </column>
            <column caption='AOV' datatype='real' name='[Calculation_1319140885667842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1319140884926464]) /&#13;&#10;COUNTD(IF [status] = &quot;delivered&quot; THEN [order_id] END)' />
            </column>
            <column caption='AOV 2024' datatype='real' name='[Calculation_1319140912398359]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF YEAR([order_datetime]) = 2024&#13;&#10;    THEN [Calculation_1319140884926464]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF YEAR([order_datetime]) = 2024&#13;&#10;    AND [status] = &quot;delivered&quot;&#13;&#10;    THEN [order_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='AOV 2025' datatype='real' name='[Calculation_1319140912529432]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF YEAR([order_datetime]) = 2025&#13;&#10;    THEN [Calculation_1319140884926464]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;    IF YEAR([order_datetime]) = 2025&#13;&#10;    AND [status] = &quot;delivered&quot;&#13;&#10;    THEN [order_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='AOV YoY Change' datatype='real' default-format='p0.00%' name='[Calculation_1319140912631833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1319140912529432] - [Calculation_1319140912398359]) / [Calculation_1319140912398359]' />
            </column>
            <column caption='AOV Change Color' datatype='string' name='[Calculation_1319140914118682]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1319140912631833] &gt;= 0 THEN &quot;Positive&quot;&#13;&#10;ELSE &quot;Negative&quot;&#13;&#10;END' />
