          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='10'>Revenue by Cuisine</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='9'>Pizza and Sushi Generate the Highest Platform Revenue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_clean+' name='federated.18qdsgh1vinxzp15u2zn219tbs1p' />
