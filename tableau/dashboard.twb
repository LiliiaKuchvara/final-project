    <worksheet name='City GMV Map'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='10'>GMV and Late Order Share Across Cities</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='9'>Kyiv Leads in GMV Among Cities</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_clean+' name='federated.18qdsgh1vinxzp15u2zn219tbs1p' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Допустиме запізнення, хв' datatype='integer' name='[Parameter 1319140902215696]' param-domain-type='range' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <range granularity='1' max='15' min='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18qdsgh1vinxzp15u2zn219tbs1p'>
            <column caption='GMV' datatype='integer' name='[Calculation_1319140884926464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &quot;delivered&quot; THEN [total_uah]&#13;&#10;END' />
            </column>
            <column caption='Is Late' datatype='integer' name='[Calculation_1319140885954564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [delivery_time_min] &gt;&#13;&#10;   [promised_time_min] + [Parameters].[Parameter 1319140902215696]&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Late Share' datatype='real' name='[Calculation_1319140886179845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_1319140885954564])' />
            </column>
            <column datatype='string' name='[city (orders_clean.csv)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;Dnipro&quot;' value='&quot;Dnipropetrovsk&quot;' />
                <semantic-value key='&quot;Odesa&quot;' value='&quot;Odessa&quot;' />
              </semantic-values>
            </column>
            <column datatype='integer' name='[delivery_time_min]' role='measure' type='quantitative' />
            <column-instance column='[city (orders_clean.csv)]' derivation='None' name='[none:city (orders_clean.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
