    <worksheet name='Top Restaurants'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='10'>Top Restaurants</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='9'>Royal Roll Leads Restaurants by GMV</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_clean+' name='federated.18qdsgh1vinxzp15u2zn219tbs1p' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top N' datatype='integer' name='[Parameter 1319140898738190]' param-domain-type='range' role='measure' type='quantitative' value='10'>
              <calculation class='tableau' formula='10' />
              <range granularity='1' max='20' min='5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18qdsgh1vinxzp15u2zn219tbs1p'>
            <column caption='GMV' datatype='integer' name='[Calculation_1319140884926464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &quot;delivered&quot; THEN [total_uah]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[city (orders_clean.csv)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;Dnipro&quot;' value='&quot;Dnipropetrovsk&quot;' />
                <semantic-value key='&quot;Odesa&quot;' value='&quot;Odessa&quot;' />
              </semantic-values>
            </column>
            <column-instance column='[city (orders_clean.csv)]' derivation='None' name='[none:city (orders_clean.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[restaurant_name]' derivation='None' name='[none:restaurant_name:nk]' pivot='key' type='nominal' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[restaurant_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1319140884926464]' derivation='Sum' name='[sum:Calculation_1319140884926464:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_date]' derivation='Month-Trunc' name='[tmn:order_date:ok]' pivot='key' type='ordinal' />
            <column datatype='integer' name='[total_uah]' role='measure' type='quantitative' />
            <column-instance column='[order_date]' derivation='Year' name='[yr:order_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.18qdsgh1vinxzp15u2zn219tbs1p].[Action (YEAR(order_date),MONTH(order_date))]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action6_505FEC009F1243B58C81A42EE2437D01]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[yr:order_date:ok]' />
              <groupfilter function='level-members' level='[tmn:order_date:ok]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.18qdsgh1vinxzp15u2zn219tbs1p].[none:restaurant_name:nk]'>
