                <semantic-value key='&quot;Odesa&quot;' value='&quot;Odessa&quot;' />
              </semantic-values>
            </column>
            <column datatype='integer' default-format='n#,##0.00;-#,##0.00' name='[customer_rating]' role='measure' type='quantitative' />
            <column datatype='integer' name='[delivery_time_min]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1051410118909952]' derivation='None' name='[none:Calculation_1051410118909952:nk]' pivot='key' type='nominal' />
            <column-instance column='[city (orders_clean.csv)]' derivation='None' name='[none:city (orders_clean.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[promised_time_min]' role='measure' type='quantitative' />
            <column-instance column='[order_date]' derivation='Year' name='[yr:order_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.18qdsgh1vinxzp15u2zn219tbs1p].[none:Calculation_1051410118909952:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_1051410118909952:nk]' member='&quot;10–20 min&quot;' />
