            <column caption='Delay Group' datatype='string' name='[Calculation_1051410118909952]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([delivery_time_min])&#13;&#10;OR ISNULL([promised_time_min]) THEN NULL&#13;&#10;&#13;&#10;ELSEIF [delivery_time_min] &lt;= [promised_time_min] THEN &quot;On time&quot;&#13;&#10;&#13;&#10;ELSEIF [delivery_time_min] &lt;= [promised_time_min] + 10 THEN &quot;Up to 10 min&quot;&#13;&#10;&#13;&#10;ELSEIF [delivery_time_min] &lt;= [promised_time_min] + 20 THEN &quot;10–20 min&quot;&#13;&#10;&#13;&#10;ELSE &quot;20+ min&quot;&#13;&#10;END' />
            </column>
