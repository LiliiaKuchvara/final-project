      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.18qdsgh1vinxzp15u2zn219tbs1p].[usr:Calculation_1051410128683009:qk]&quot;' value='Service per Customer' />
          <alias key='&quot;[federated.18qdsgh1vinxzp15u2zn219tbs1p].[usr:Calculation_1051410149826564:qk]&quot;' value='Orders' />
          <alias key='&quot;[federated.18qdsgh1vinxzp15u2zn219tbs1p].[usr:Calculation_1051410150117381:qk]&quot;' value='Average Check (UAH)' />
          <alias key='&quot;[federated.18qdsgh1vinxzp15u2zn219tbs1p].[usr:Calculation_1051410150330374:qk]&quot;' value='Total Discounts (UAH)' />
        </aliases>
      </column>
      <column caption='Delay Group' datatype='string' name='[Calculation_1051410118909952]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([delivery_time_min])&#13;&#10;OR ISNULL([promised_time_min]) THEN NULL&#13;&#10;&#13;&#10;ELSEIF [delivery_time_min] &lt;= [promised_time_min] THEN &quot;On time&quot;&#13;&#10;&#13;&#10;ELSEIF [delivery_time_min] &lt;= [promised_time_min] + 10 THEN &quot;Up to 10 min&quot;&#13;&#10;&#13;&#10;ELSEIF [delivery_time_min] &lt;= [promised_time_min] + 20 THEN &quot;10–20 min&quot;&#13;&#10;&#13;&#10;ELSE &quot;20+ min&quot;&#13;&#10;END' />
      </column>
      <column caption='Service Revenue per Customer' datatype='real' name='[Calculation_1051410128683009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1319140885143553]) / COUNTD([customer_id])' />
      </column>
      <column caption='САС' datatype='real' name='[Calculation_1051410128879618]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE LOWER([acquisition_channel])&#13;&#10;WHEN &quot;referral&quot; THEN 100.00&#13;&#10;WHEN &quot;google_ads&quot; THEN 402.95&#13;&#10;WHEN &quot;instagram&quot; THEN 365.80&#13;&#10;WHEN &quot;tiktok&quot; THEN 413.77&#13;&#10;WHEN &quot;organic&quot; THEN NULL&#13;&#10;END' />
      </column>
      <column caption='Orders Count' datatype='integer' name='[Calculation_1051410149826564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Average Check' datatype='real' name='[Calculation_1051410150117381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([subtotal_uah])' />
      </column>
      <column caption='Total Discounts' datatype='integer' name='[Calculation_1051410150330374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([discount_uah])' />
      </column>
      <column caption='GMV' datatype='integer' name='[Calculation_1319140884926464]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;delivered&quot; THEN [total_uah]&#13;&#10;END' />
      </column>
      <column caption='Platform Revenue' datatype='real' name='[Calculation_1319140885143553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [status] = &quot;delivered&quot; THEN&#13;&#10;    [subtotal_uah] * [commission_rate]&#13;&#10;    + [delivery_fee_uah]&#13;&#10;    - [discount_uah]&#13;&#10;END' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1319140885667842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1319140884926464]) /&#13;&#10;COUNTD(IF [status] = &quot;delivered&quot; THEN [order_id] END)' />
      </column>
      <column caption='Cancel Rate' datatype='real' name='[Calculation_1319140885815299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [status] = &quot;cancelled&quot; THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([order_id])' />
      </column>
      <column caption='Is Late' datatype='integer' name='[Calculation_1319140885954564]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [delivery_time_min] &gt;&#13;&#10;   [promised_time_min] + [Parameters].[Parameter 1319140902215696]&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Late Share' datatype='real' name='[Calculation_1319140886179845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1319140885954564])' />
      </column>
      <column caption='Distance Group' datatype='string' name='[Calculation_1319140886327302]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [distance_km] &lt; 2 THEN &quot;0–2 km&quot;&#13;&#10;ELSEIF [distance_km] &lt; 4 THEN &quot;2–4 km&quot;&#13;&#10;ELSEIF [distance_km] &lt; 6 THEN &quot;4–6 km&quot;&#13;&#10;ELSE &quot;6+ km&quot;&#13;&#10;END' />
      </column>
      <column caption='Order Hour' datatype='integer' name='[Calculation_1319140886544391]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [order_datetime])' />
      </column>
      <column caption='First Order Date' datatype='datetime' name='[Calculation_1319140887113736]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : MIN([order_datetime]) }' />
      </column>
      <column caption='New vs Returning' datatype='string' name='[Calculation_1319140887175177]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_datetime] = [Calculation_1319140887113736]&#13;&#10;THEN &quot;New&quot;&#13;&#10;ELSE &quot;Returning&quot;&#13;&#10;END' />
      </column>
      <column caption='Orders per Customer' datatype='integer' name='[Calculation_1319140887568394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : COUNTD([order_id]) }' />
