    <worksheet name='Promo Code Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='10'>Promo Code Performance</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='9'>WELCOME20 Leads in Orders, While FRIDAY15 Generates the Highest Discounts</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_clean+' name='federated.18qdsgh1vinxzp15u2zn219tbs1p' />
          </datasources>
          <datasource-dependencies datasource='federated.18qdsgh1vinxzp15u2zn219tbs1p'>
            <column caption='Orders Count' datatype='integer' name='[Calculation_1051410149826564]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='Average Check' datatype='real' name='[Calculation_1051410150117381]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([subtotal_uah])' />
            </column>
            <column caption='Total Discounts' datatype='integer' name='[Calculation_1051410150330374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([discount_uah])' />
            </column>
            <column datatype='string' name='[city (orders_clean.csv)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;Dnipro&quot;' value='&quot;Dnipropetrovsk&quot;' />
                <semantic-value key='&quot;Odesa&quot;' value='&quot;Odessa&quot;' />
