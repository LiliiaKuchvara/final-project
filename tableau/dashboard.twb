  <worksheets>
    <worksheet name='Acquisition Channel Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='10'>Service Revenue per Customer vs CAC by Acquisition Channel</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#24445c' fontname='Arial' fontsize='9'>Revenue per Customer Exceeds CAC Across All Paid Channels</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='orders_clean+' name='federated.18qdsgh1vinxzp15u2zn219tbs1p' />
          </datasources>
          <datasource-dependencies datasource='federated.18qdsgh1vinxzp15u2zn219tbs1p'>
            <column caption='Service Revenue per Customer' datatype='real' name='[Calculation_1051410128683009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1319140885143553]) / COUNTD([customer_id])' />
            </column>
            <column caption='САС' datatype='real' name='[Calculation_1051410128879618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE LOWER([acquisition_channel])&#13;&#10;WHEN &quot;referral&quot; THEN 100.00&#13;&#10;WHEN &quot;google_ads&quot; THEN 402.95&#13;&#10;WHEN &quot;instagram&quot; THEN 365.80&#13;&#10;WHEN &quot;tiktok&quot; THEN 413.77&#13;&#10;WHEN &quot;organic&quot; THEN NULL&#13;&#10;END' />
            </column>
            <column caption='Platform Revenue' datatype='real' name='[Calculation_1319140885143553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [status] = &quot;delivered&quot; THEN&#13;&#10;    [subtotal_uah] * [commission_rate]&#13;&#10;    + [delivery_fee_uah]&#13;&#10;    - [discount_uah]&#13;&#10;END' />
            </column>
            <column datatype='string' name='[acquisition_channel]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1051410128879618]' derivation='Avg' name='[avg:Calculation_1051410128879618:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[city (orders_clean.csv)]' role='dimension' semantic-role='[City].[Name]' type='nominal'>
              <semantic-values semantic-role='[City].[Name]'>
                <semantic-value key='&quot;Dnipro&quot;' value='&quot;Dnipropetrovsk&quot;' />
                <semantic-value key='&quot;Odesa&quot;' value='&quot;Odessa&quot;' />
              </semantic-values>
            </column>
            <column datatype='real' name='[commission_rate]' role='measure' type='quantitative' />
            <column datatype='string' name='[customer_id]' role='dimension' type='nominal' />
            <column datatype='integer' name='[delivery_fee_uah]' role='measure' type='quantitative' />
            <column datatype='integer' name='[discount_uah]' role='measure' type='quantitative' />
            <column-instance column='[acquisition_channel]' derivation='None' name='[none:acquisition_channel:nk]' pivot='key' type='nominal' />
            <column-instance column='[city (orders_clean.csv)]' derivation='None' name='[none:city (orders_clean.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[order_date]' derivation='None' name='[none:order_date:qk]' pivot='key' type='quantitative' />
            <column datatype='date' name='[order_date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column datatype='integer' name='[subtotal_uah]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1051410128683009]' derivation='User' name='[usr:Calculation_1051410128683009:qk]' pivot='key' type='quantitative' />
            <column-instance column='[order_date]' derivation='Year' name='[yr:order_date:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
